# Python
__pycache__/
*.py[cod]
.pytest_cache/

# 虚拟环境
.venv/
venv/

# 日志
*.log
client_logs.txt

# 临时脚本与产物（约定存放于 tmp/）
tmp/

# zig 编译缓存与调试符号（eos_stub.dll/lib 保留，可用 eos_stub.c 重建）
.zigcache/
*.pdb

# 证书（首次运行 eos_fake_backend.py 自动生成，用 eos_fake_setup.ps1 装入系统）
certs/

# 环境变量（真实部署配置，模板见 .env.example）
.env
.env.production

# 历史日志（按天轮转产物）
realtest_game.log.*.log

# fs 同步 CAS 大文件（部署产物：改动过的客户端文件以 sha256-size_flag 命名放入，
# 不入库，可从客户端原文件重新生成）
cas/
