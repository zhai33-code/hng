# hng-re 服务器环境配置
# 复制为 .env 后按需修改；.env 不入库（真实部署配置勿提交）
# shell 导出的同名环境变量优先级高于本文件

# ---- 对外地址（外网开服必填）----
# 下发给客户端的连接地址：Settings.js(flash_dynhttp/文件服务器/账号页)、
# 匹配成局 game_connect(客户端 hng.exe 连战斗服)、HostingCenter ping。
# 默认 127.0.0.1（本机测试）；外网开服填服务器公网 IP，如 203.0.113.10
#HNG_PUBLIC_HOST=127.0.0.1

# ---- 服务器路径 ----
# 私服客户端根目录（含 WarDatabase + images），不设则自动探测
#HNG_GAME_DIR=/path/to/HnG
# combat server 目录（含 hng.exe），不设则自动探测
#HNG_COMBAT_SERVER_DIR=/path/to/combat-server

# ---- 匹配池 / combat server 并发 ----
# 同时运行的 combat server 最大实例数（0 = 不限）
#MM_MAX_COMBAT_SERVERS=4
# combat server UDP 端口池范围
#MM_COMBAT_PORT_BASE=5678
#MM_COMBAT_PORT_MAX=5699
# 排队超时 AI 补位秒数
#MM_AI_FILL_AFTER=30
# 模拟 combat server（不拉 hng.exe，服务器内嵌模拟握手；仅调试用）
#MM_SIMULATE_COMBAT=0

# ---- RTS 战争补给 ----
# 战争行 f22：库存不足时允许增援进入阵营补给队列
#MM_WAR_QUEUE_REINFORCEMENTS=1
# 战争行 f23：仅部署时的首批兵员/载具免费；后续补编仍按定价收费
#MM_WAR_FIRST_RESOURCE_FREE=1
# 已部署 AT 的补编运输：0=即时交付，1=补给网外出车队，2=一律出车队
#MM_WAR_SUPPLY_COLUMN_MODE=2
# 库存只能满足一部分时，是否先交付已有数量并将余量入队
#MM_WAR_SUPPLY_INSTANT_PARTIAL=1
# WarDatabase 缺少城市坐标时单段行军回退秒数
#MM_WAR_SEGMENT_FALLBACK_SECONDS=300
# AT 会战经验：参战基础值 / 获胜额外值
#MM_WAR_AT_XP_PER_BATTLE=5
#MM_WAR_AT_XP_WIN_BONUS=25
# 专用服开局倒计时覆盖；0=使用引擎默认值
#MM_COMBAT_START_COUNTDOWN_OVERRIDE=10
# 普通地图没有 battlefield 行时保持 0；不要填入无关城市 id
#MM_MISSION_MAP_ENTITY_FALLBACK=0

# ---- combat server 分离部署（可选）----
# combat server 回连 warserver 的地址；默认 127.0.0.1:15110（同机）
#HNG_COMBAT_WARSERVER=127.0.0.1:15110
# 远端 agent 的 HMAC 共享密钥（多机部署时 warserver 与各远端 combat_agent.py
# --token 同值；生成：python -c "import secrets; print(secrets.token_urlsafe(32))"）。
# 每请求签名（密钥不上链路 + 时间戳/nonce 防重放），跨公网明文 HTTP 安全；
# 两端时钟偏差须 <90s。留空 = 远端 agent 不校验，仅限内网调试。多机主机表
# 本身在管理后台「服务器配置 → 战斗服主机」热配置（server_config 表
# combat_hosts 行），保存即生效；本文件环境变量仅在未保存主机表时作为
# 单机回退值。模块级读取，改后须重启游戏服
#HNG_AGENT_TOKEN=

# ---- 数据库 ----
# 远程 PostgreSQL 连接串；不设则用默认 127.0.0.1:5432/hng（本机/WSL Docker 自动探测）
#HNG_DATABASE_URL=postgresql://hng:hng_password@192.168.1.5:5432/hng

# ---- 日志 ----
# 保留天数（按天轮转）
#LOG_KEEP_DAYS=3

# ---- 管理后台（web/server/，独立进程）----
# 监听地址：默认仅回环（公网不可达，远程管理走 SSH 隧道）
#HNG_ADMIN_BIND=127.0.0.1
# 监听端口（默认 8080）
#HNG_ADMIN_PORT=8080
# JWT 签发密钥：不设则自动生成随机密钥落 web/server/.admin_secret（gitignore）。
# 显式设置固定密钥适用于多实例部署；删除 .admin_secret 文件 = 应急全体登出。
#HNG_ADMIN_SECRET=
